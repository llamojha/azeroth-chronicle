{
  "mcpServers": {
    "wow-api": {
      "command": "npx",
      "args": ["-y", "@nighthawk42/wow-api-mcp"],
      "env": {
        "WOW_API_MCP_FLAVOR": "forever"
      },
      "disabled": false,
      "autoApprove": []
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "timeout": 100000,
      "transport": "stdio",
      "disabled": false,
      "autoApprove": []
    }
  }
}
